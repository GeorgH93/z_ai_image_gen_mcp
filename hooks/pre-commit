#!/bin/sh
# Auto-rebuild dist/ when src/ files are staged for commit.
# Installed automatically by the `prepare` npm script (runs on `npm install`).

# Only trigger if at least one staged file lives under src/
if ! git diff --cached --name-only --diff-filter=ACMR | grep -q '^src/'; then
  exit 0
fi

echo "src/ changed - rebuilding dist/..."
npm --silent run build || {
  echo "Build failed - aborting commit. Fix the errors and try again." >&2
  exit 1
}

# Stage the rebuilt output so it lands in the same commit
git add dist/
echo "dist/ rebuilt and staged."
